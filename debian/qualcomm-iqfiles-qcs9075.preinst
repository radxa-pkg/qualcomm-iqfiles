#!/bin/sh
set -e

case $1 in
install | upgrade)
	# Provided by qcom-chicdk-qcs9100.
	conflicts="
        /usr/lib/qcs9100/camera/com.qti.tuned.lemans_rpi_imx577.bin
        "
	for i in $conflicts; do
		dpkg-divert --package qualcomm-iqfiles-qcs9075 --divert "$i.bak" --rename "$i"
	done
	;;
esac

#DEBHELPER#

exit 0
